<?xml version="1.0" encoding="utf-8"?>
<!--
  不计入账户（记一笔时选它 = 这笔流水不动任何账户的余额）：
  灰色立体底 + 白色铅笔。按截图规格画成"斜放的铅笔"，用 group 旋转 45°，
  比手写斜向 pathData 好维护；灰色是刻意选的 —— 它不代表任何真实账户，
  不能和账户品牌色抢注意力。
  这个图标不进任何开户图标池（forTypes = emptySet()），只给流水列表/详情页显示账户那一栏用。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path android:pathData="M5,0 L19,0 A5,5 0 0,1 24,5 L24,19 A5,5 0 0,1 19,24 L5,24 A5,5 0 0,1 0,19 L0,5 A5,5 0 0,1 5,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="2" android:startY="1" android:endX="22" android:endY="23">
                <item android:offset="0" android:color="#FFD2D9E6"/>
                <item android:offset="1" android:color="#FF9AA4B8"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M5,0 L19,0 A5,5 0 0,1 24,5 L24,9 C17.5,12.8 6.5,12.8 0,9 L0,5 A5,5 0 0,1 5,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="12" android:startY="0" android:endX="12" android:endY="11">
                <item android:offset="0" android:color="#33FFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>
    <group android:name="pencil" android:rotation="45" android:pivotX="12" android:pivotY="12">
        <!-- 笔身 -->
        <path android:fillColor="#FFFFFF" android:pathData="M9.9,4.6 H14.1 V14.8 H9.9 Z"/>
        <!-- 笔尖 -->
        <path android:fillColor="#FFFFFF" android:pathData="M9.9,14.8 L12,19.4 L14.1,14.8 Z"/>
        <!-- 笔尾（淡一档，让铅笔读出两段） -->
        <path android:fillColor="#B3FFFFFF" android:pathData="M9.9,4.6 H14.1 V6.4 H9.9 Z"/>
    </group>
</vector>
